<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/tab_navigation_item_size"
    android:layout_height="@dimen/tab_navigation_item_size"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_navigation_item_focus">

    <ImageView
        android:id="@+id/section_rail_icon"
        android:layout_width="@dimen/tab_active_indicator_size"
        android:layout_height="@dimen/tab_active_indicator_size"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:tint="@color/overview_tab_icon_color" />
</FrameLayout>
