<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.DeviceInfo.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DeviceInfo.Button.Primary" parent="Widget.Material3.Button">
        <item name="deviceInfoButtonVariant">primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/btn_primary_background_tint</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Uses theme colorError (Material You). -->
    <style name="Widget.DeviceInfo.Button.Danger" parent="Widget.Material3.Button">
        <item name="deviceInfoButtonVariant">danger</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/btn_danger_background_tint</item>
        <item name="android:textColor">@color/btn_danger_text</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
